{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scopa-online-2v2",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCOPA_ROOMS",
        "class_name": "ScopaRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ScopaRoom"]
    }
  ]
}
